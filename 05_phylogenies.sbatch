#!/bin/bash

#SBATCH --partition=forsythe.q
#SBATCH --account=forsythe
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=8G
#SBATCH --time=04:00:00
#SBATCH --job-name=phylogenies
#SBATCH --mail-user=evan.forsythe@osucascades.edu
#SBATCH --mail-type=END,FAIL


# ============================================================
# STEP 5: Structural and standard phylogenetic inference
# ============================================================
#
# Usage:
#
# sbatch 05_phylogenies.sbatch <input_fasta> <output_dir>
#
# Example:
#
# sbatch 05_phylogenies.sbatch \
#   /scratch/forsythe/Structural_phylogenetics/RNAase_T2_RNS1_family/HOG0015056.fa \
#   /scratch/forsythe/Structural_phylogenetics/RNAase_T2_RNS1_family
#
#
# STRUCTURAL PHYLOGENY
# --------------------
#
# Input:
#   FoldMason 3Di structural alignment generated by Script 4
#
# Alignment:
#   <output_dir>/foldmason/<family>_foldmason_3di.fa
#
# Model:
#   Q.3Di.AF
#
# Tree inference:
#   IQ-TREE 3 + 1000 ultrafast bootstrap replicates
#
#
# STANDARD PHYLOGENY
# ------------------
#
# Input:
#   Original protein FASTA
#
# Alignment:
#   MAFFT
#
# Model:
#   Automatically selected by IQ-TREE ModelFinder
#
# Tree inference:
#   IQ-TREE 3 + 1000 ultrafast bootstrap replicates
#
# ============================================================


# ------------------------------------------------------------
# Parse arguments
# ------------------------------------------------------------

INPUT_FASTA="$1"
OUTPUT_DIR="$2"

if [[ -z "$INPUT_FASTA" || -z "$OUTPUT_DIR" ]]; then

    echo "ERROR: Missing required arguments."
    echo
    echo "Usage:"
    echo "sbatch 05_phylogenies.sbatch <input_fasta> <output_dir>"

    exit 1
fi


# ------------------------------------------------------------
# Convert paths to absolute paths
# ------------------------------------------------------------

INPUT_FASTA=$(realpath "$INPUT_FASTA")
OUTPUT_DIR=$(realpath -m "$OUTPUT_DIR")


# ------------------------------------------------------------
# Validate input FASTA
# ------------------------------------------------------------

if [[ ! -f "$INPUT_FASTA" ]]; then

    echo "ERROR: Input FASTA does not exist:"
    echo "$INPUT_FASTA"

    exit 1
fi


# ------------------------------------------------------------
# Determine family name
# ------------------------------------------------------------

FASTA_BASENAME=$(basename "$INPUT_FASTA")

FAMILY_NAME="${FASTA_BASENAME%.fasta}"
FAMILY_NAME="${FAMILY_NAME%.faa}"
FAMILY_NAME="${FAMILY_NAME%.fa}"


# ------------------------------------------------------------
# Define paths
# ------------------------------------------------------------

FOLDMASON_DIR="${OUTPUT_DIR}/foldmason"

STRUCTURAL_ALIGNMENT="${FOLDMASON_DIR}/${FAMILY_NAME}_foldmason_3di.fa"

PHYLOGENY_DIR="${OUTPUT_DIR}/phylogenies"

STRUCTURAL_DIR="${PHYLOGENY_DIR}/structural"
STANDARD_DIR="${PHYLOGENY_DIR}/standard"

LOG_DIR="${OUTPUT_DIR}/logs"

MODEL_FILE="/scratch/forsythe/Structural_phylogenetics/Q.3Di.AF"


# Standard amino-acid alignment

STANDARD_ALIGNMENT="${STANDARD_DIR}/${FAMILY_NAME}_mafft.fa"


# IQ-TREE output prefixes

STRUCTURAL_PREFIX="${STRUCTURAL_DIR}/${FAMILY_NAME}_3di"

STANDARD_PREFIX="${STANDARD_DIR}/${FAMILY_NAME}_aa"


# ------------------------------------------------------------
# Create directories
# ------------------------------------------------------------

mkdir -p "$STRUCTURAL_DIR"
mkdir -p "$STANDARD_DIR"
mkdir -p "$LOG_DIR"


# ------------------------------------------------------------
# Redirect stdout/stderr to project log
# ------------------------------------------------------------

LOG_FILE="${LOG_DIR}/phylogenies_${SLURM_JOB_ID}.log"

exec > >(tee -a "$LOG_FILE") 2>&1


# ------------------------------------------------------------
# Activate environment
# ------------------------------------------------------------

source /opt/ohpc/pub/apps/anaconda/3.12/etc/profile.d/conda.sh

conda activate structural_phylo


# ------------------------------------------------------------
# Print job information
# ------------------------------------------------------------

echo
echo "============================================================"
echo "Structural + standard phylogenetic analysis"
echo "============================================================"
echo
echo "Date:                 $(date)"
echo "SLURM job ID:         ${SLURM_JOB_ID}"
echo "Node:                 $(hostname)"
echo
echo "Family:               ${FAMILY_NAME}"
echo "Input FASTA:          ${INPUT_FASTA}"
echo
echo "Structural alignment: ${STRUCTURAL_ALIGNMENT}"
echo "Q.3Di.AF model:       ${MODEL_FILE}"
echo
echo "Standard alignment:   ${STANDARD_ALIGNMENT}"
echo
echo "Output directory:     ${PHYLOGENY_DIR}"
echo "Log file:             ${LOG_FILE}"
echo


# ============================================================
# SOFTWARE CHECKS
# ============================================================

echo "============================================================"
echo "Checking software"
echo "============================================================"
echo


if ! command -v mafft >/dev/null 2>&1; then

    echo "ERROR: MAFFT not found in current environment."

    exit 1
fi


if ! command -v iqtree3 >/dev/null 2>&1; then

    echo "ERROR: iqtree3 not found in current environment."

    exit 1
fi


echo "MAFFT:"
which mafft

echo
mafft --version

echo
echo "IQ-TREE:"
which iqtree3

echo
iqtree3 --version

echo


# ============================================================
# INPUT VALIDATION
# ============================================================

echo "============================================================"
echo "Validating inputs"
echo "============================================================"
echo


if [[ ! -f "$STRUCTURAL_ALIGNMENT" ]]; then

    echo "ERROR: FoldMason 3Di alignment does not exist:"
    echo "$STRUCTURAL_ALIGNMENT"
    echo
    echo "Run Script 4 first."

    exit 1
fi


if [[ ! -f "$MODEL_FILE" ]]; then

    echo "ERROR: Q.3Di.AF substitution matrix does not exist:"
    echo "$MODEL_FILE"

    exit 1
fi


ORIGINAL_COUNT=$(grep -c '^>' "$INPUT_FASTA")
STRUCTURAL_COUNT=$(grep -c '^>' "$STRUCTURAL_ALIGNMENT")


echo "Original FASTA sequences: ${ORIGINAL_COUNT}"
echo "3Di alignment sequences:  ${STRUCTURAL_COUNT}"
echo


if [[ "$ORIGINAL_COUNT" -ne "$STRUCTURAL_COUNT" ]]; then

    echo "ERROR: Original FASTA and structural alignment"
    echo "contain different numbers of sequences."

    exit 1
fi


# ============================================================
# 1. STRUCTURAL PHYLOGENY
# ============================================================

echo
echo "============================================================"
echo "1. STRUCTURAL PHYLOGENY"
echo "============================================================"
echo
echo "Alignment: ${STRUCTURAL_ALIGNMENT}"
echo "Model:     ${MODEL_FILE}"
echo "Bootstrap: 1000"
echo


iqtree3 \
    -s "$STRUCTURAL_ALIGNMENT" \
    -m "$MODEL_FILE" \
    -bb 1000 \
    -nt AUTO \
    -ntmax "${SLURM_CPUS_PER_TASK}" \
    -pre "$STRUCTURAL_PREFIX"


STRUCTURAL_STATUS=$?


if [[ $STRUCTURAL_STATUS -ne 0 ]]; then

    echo
    echo "ERROR: Structural IQ-TREE analysis failed."
    echo "Exit status: ${STRUCTURAL_STATUS}"

    exit $STRUCTURAL_STATUS
fi


echo
echo "Structural phylogeny completed successfully."
echo
echo "Tree:"
echo "${STRUCTURAL_PREFIX}.treefile"
echo


# ============================================================
# 2. STANDARD AMINO-ACID ALIGNMENT
# ============================================================

echo
echo "============================================================"
echo "2. STANDARD AMINO-ACID ALIGNMENT"
echo "============================================================"
echo
echo "Running MAFFT..."
echo


mafft \
    --auto \
    --thread "${SLURM_CPUS_PER_TASK}" \
    "$INPUT_FASTA" \
    > "$STANDARD_ALIGNMENT"


MAFFT_STATUS=$?


if [[ $MAFFT_STATUS -ne 0 ]]; then

    echo
    echo "ERROR: MAFFT failed."
    echo "Exit status: ${MAFFT_STATUS}"

    exit $MAFFT_STATUS
fi


echo
echo "MAFFT completed successfully."
echo "Alignment:"
echo "$STANDARD_ALIGNMENT"
echo


# ------------------------------------------------------------
# Verify taxon count after MAFFT
# ------------------------------------------------------------

STANDARD_COUNT=$(grep -c '^>' "$STANDARD_ALIGNMENT")


echo "Original FASTA sequences: ${ORIGINAL_COUNT}"
echo "MAFFT sequences:          ${STANDARD_COUNT}"
echo


if [[ "$STANDARD_COUNT" -ne "$ORIGINAL_COUNT" ]]; then

    echo "ERROR: MAFFT alignment contains an unexpected"
    echo "number of sequences."

    exit 1
fi


# ============================================================
# 3. STANDARD AMINO-ACID PHYLOGENY
# ============================================================

echo
echo "============================================================"
echo "3. STANDARD AMINO-ACID PHYLOGENY"
echo "============================================================"
echo
echo "Alignment: ${STANDARD_ALIGNMENT}"
echo "Model:     ModelFinder automatic selection"
echo "Bootstrap: 1000"
echo


iqtree3 \
    -s "$STANDARD_ALIGNMENT" \
    -m MFP \
    -bb 1000 \
    -nt AUTO \
    -ntmax "${SLURM_CPUS_PER_TASK}" \
    -pre "$STANDARD_PREFIX"


STANDARD_STATUS=$?


if [[ $STANDARD_STATUS -ne 0 ]]; then

    echo
    echo "ERROR: Standard IQ-TREE analysis failed."
    echo "Exit status: ${STANDARD_STATUS}"

    exit $STANDARD_STATUS
fi


# ============================================================
# FINAL SUMMARY
# ============================================================

echo
echo "============================================================"
echo "STEP 5 COMPLETED SUCCESSFULLY"
echo "============================================================"
echo
echo "Family:"
echo "  ${FAMILY_NAME}"
echo
echo "Taxa:"
echo "  ${ORIGINAL_COUNT}"
echo
echo "STRUCTURAL PHYLOGENY"
echo
echo "  Alignment:"
echo "  ${STRUCTURAL_ALIGNMENT}"
echo
echo "  Tree:"
echo "  ${STRUCTURAL_PREFIX}.treefile"
echo
echo "  Bootstrap consensus:"
echo "  ${STRUCTURAL_PREFIX}.contree"
echo
echo "STANDARD PHYLOGENY"
echo
echo "  Alignment:"
echo "  ${STANDARD_ALIGNMENT}"
echo
echo "  Tree:"
echo "  ${STANDARD_PREFIX}.treefile"
echo
echo "  Bootstrap consensus:"
echo "  ${STANDARD_PREFIX}.contree"
echo
echo "Finished: $(date)"
echo
echo "============================================================"